  "PolicyDocument": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Action\":[\"s3:GetObject\",\"s3:GetObjectVersion\"],\"Effect\":\"Allow\",\"Resource\":\"arn:aws:s3:::oficina-phase3-artifacts-16225b7358/releases/app/staging/*\",\"Sid\":\"ReadOnlyReviewedSourcePrefix\"},{\"Action\":\"logs:CreateLogGroup\",\"Effect\":\"Allow\",\"Resource\":\"arn:aws:logs:us-east-1:638612472889:log-group:/aws/codebuild/oficina-phase3-oficina-app-staging-deploy\",\"Sid\":\"CreateOnlyThisBuildLogGroup\"},{\"Action\":[\"logs:CreateLogStream\",\"logs:PutLogEvents\"],\"Effect\":\"Allow\",\"Resource\":\"arn:aws:logs:us-east-1:638612472889:log-group:/aws/codebuild/oficina-phase3-oficina-app-staging-deploy:log-stream:*\",\"Sid\":\"WriteOnlyThisBuildLogGroup\"},{\"Action\":[\"ec2:CreateNetworkInterface\",\"ec2:DescribeDhcpOptions\",\"ec2:DescribeNetworkInterfaces\",\"ec2:DeleteNetworkInterface\",\"ec2:DescribeSubnets\",\"ec2:DescribeSecurityGroups\",\"ec2:DescribeVpcs\"],\"Effect\":\"Allow\",\"Resource\":\"*\",\"Sid\":\"CodeBuildVpcNetworkInterfaces\"},{\"Action\":\"ec2:CreateNetworkInterfacePermission\",\"Condition\":{\"ArnEquals\":{\"ec2:Subnet\":[\"arn:aws:ec2:us-east-1:638612472889:subnet/subnet-0e49c88c97a118461\",\"arn:aws:ec2:us-east-1:638612472889:subnet/subnet-06c013de9577c7f0b\"]},\"StringEquals\":{\"ec2:AuthorizedService\":\"codebuild.amazonaws.com\"}},\"Effect\":\"Allow\",\"Resource\":\"arn:aws:ec2:us-east-1:638612472889:network-interface/*\",\"Sid\":\"CodeBuildVpcNetworkInterfacePermission\"},{\"Action\":[\"ecr:BatchCheckLayerAvailability\",\"ecr:BatchGetImage\",\"ecr:GetDownloadUrlForLayer\"],\"Effect\":\"Allow\",\"Resource\":\"arn:aws:ecr:us-east-1:638612472889:repository/oficina-phase3-deployer\",\"Sid\":\"PullOnlyPlatformDeployerImage\"},{\"Action\":\"ecr:GetAuthorizationToken\",\"Effect\":\"Allow\",\"Resource\":\"*\",\"Sid\":\"AuthenticateOnlyToPullPlatformImage\"},{\"Action\":\"s3:ListBucket\",\"Condition\":{\"StringLike\":{\"s3:prefix\":[\"app/staging.tfstate\",\"app/stagin