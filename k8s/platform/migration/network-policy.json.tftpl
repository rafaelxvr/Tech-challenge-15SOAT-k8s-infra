{"apiVersion":"networking.k8s.io/v1","kind":"NetworkPolicy","metadata":{"name":"oficina-migration-allow-required-paths","namespace":"oficina-staging","labels":{"app.kubernetes.io/part-of":"oficina","app.kubernetes.io/managed-by":"oficina-k8s-infra"}},"spec":{"podSelector":{"matchLabels":{"app.kubernetes.io/name":"oficina-migration"}},"policyTypes":["Egress"],"egress":[{"to":[{"namespaceSelector":{"matchLabels":{"kubernetes.io/metadata.name":"kube-system"}},"podSelector":{"matchLabels":{"k8s-app":"kube-dns"}}}],"ports":[{"protocol":"UDP","port":53},{"protocol":"TCP","port":53}]},{"to":${DATABASE_PEERS},"ports":[{"protocol":"TCP","port":5432}]},{"to":${HTTPS_PEERS},"ports":[{"protocol":"TCP","port":443}]}]}}
